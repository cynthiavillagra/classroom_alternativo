# ══════════════════════════════════════════════════════════════
# Classroom Explorer - Variables de Entorno
# ══════════════════════════════════════════════════════════════
# 
# INSTRUCCIONES:
# 1. Copia este archivo como .env
# 2. Reemplaza los placeholders con tus valores reales
# 3. NUNCA subas .env a Git (ya está en .gitignore)
#
# ══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# 🔐 Google OAuth 2.0
# Obtén estos valores en: https://console.cloud.google.com/
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<TU_CLIENT_ID_DE_GOOGLE>
GOOGLE_CLIENT_SECRET=<TU_CLIENT_SECRET_DE_GOOGLE>

# ─────────────────────────────────────────────────────────────
# 🌐 URLs de la Aplicación
# ─────────────────────────────────────────────────────────────
# Para desarrollo local:
APP_URL=http://localhost:5000
OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/callback

# Para producción (cuando despliegues):
# APP_URL=https://tu-app.vercel.app
# OAUTH_REDIRECT_URI=https://tu-app.vercel.app/api/auth/callback

# ─────────────────────────────────────────────────────────────
# 🔑 Secreto para Sesiones
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────
SESSION_SECRET=<GENERA_UN_SECRET_ALEATORIO_DE_64_CARACTERES>

# ─────────────────────────────────────────────────────────────
# 🧪 Entorno
# ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
# ENVIRONMENT=production
