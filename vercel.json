{
  "functions": {
    "api/index.py": {
      "includeFiles": "../public/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/materials",
      "destination": "/materials.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    }
  ]
}